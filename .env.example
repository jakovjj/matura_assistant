# Copy to .env and adjust for the deployment host.

HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=azm_session
AUTH_STORE_FILE=var/auth-store.json

# Prototype limits for account creation and password login.
AUTH_ACCOUNT_LIMIT_PER_HOUR=20
AUTH_IP_LIMIT_PER_HOUR=80
SESSION_TTL_DAYS=30
