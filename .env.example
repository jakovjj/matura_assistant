# Copy to .env and adjust for the deployment host.

HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=
AUTH_SECRET=replace-with-a-long-random-secret
AGENT_KEY_ENCRYPTION_SECRET=replace-with-a-separate-long-random-secret
AUTH_COOKIE_NAME=azm_session
DATABASE_FILE=var/asistent-za-mature.sqlite

# Create a Web application OAuth client in Google Auth Platform.
# Add this exact local callback as an Authorized redirect URI:
# http://localhost:8080/api/auth/google/callback
# For production, replace it with https://your-domain.example/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Prototype limit for starting Google OAuth flows.
AUTH_IP_LIMIT_PER_HOUR=80
SESSION_TTL_DAYS=30
