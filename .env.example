# Copy to .env and adjust for the deployment host.

HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=https://example.com
AUTH_SECRET=replace-with-a-long-random-secret

# Development default: writes login links to the server log.
MAIL_TRANSPORT=log
MAIL_FROM="Asistent za Mature <noreply@example.com>"

# Option A: use a local sendmail-compatible MTA.
# MAIL_TRANSPORT=sendmail
# SENDMAIL_PATH=/usr/sbin/sendmail

# Option B: use SMTP. Requires `npm install` because SMTP uses nodemailer.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=noreply@example.com
# SMTP_PASS=replace-with-smtp-password
